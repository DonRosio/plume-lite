# Copy to `.env` (git-ignored). Every variable can also be set in the real environment.

# SQLite database file, created on first start (with its folder).
DATABASE_PATH=data/plume-lite.db
BIND_ADDR=0.0.0.0:8080
RUST_LOG=plume_lite_server=info,tower_http=info

SESSION_TTL_DAYS=30
# Only behind a reverse proxy you control (Caddy, nginx…): trust X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT=true
