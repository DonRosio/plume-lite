# Copy to `.env` (git-ignored). Every variable can also be set in the real environment.

# SQLite database file, created on first start (with its folder).
DATABASE_PATH=data/plume-lite.db
BIND_ADDR=0.0.0.0:8080
RUST_LOG=plume_lite_server=info,tower_http=info

SESSION_TTL_DAYS=30
# Only behind a reverse proxy you control (Caddy, nginx…): trust X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT=true

# Development only: anyone can create an account (scripts/seed_demo.py needs it).
# In production, leave it unset: an invite code is required (`plume-lite-server invite`).
OPEN_REGISTRATION=true
# Daily backups, next to the database by default ("off" disables them); how many are kept.
# BACKUP_DIR=data/backups
# BACKUP_KEEP=7
# Files served under /download/ (the Windows client, in the release image).
# DOWNLOADS_DIR=downloads

# Voice: the development LiveKit of docker-compose.yml (`docker compose up -d livekit`).
# Leave these unset and voice channels answer "voice is not enabled".
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret
