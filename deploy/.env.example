# Copy to /srv/plume-lite/.env on the server. The version to run: a tag of the image
# ghcr.io/donrosio/plume-lite-server, published by the Release workflow (git tag v0.4.0).
PLUME_LITE_VERSION=0.6.1

# Voice (LiveKit). The address clients connect to (same domain as the site, through Caddy):
LIVEKIT_URL=wss://plume.donrgames.fr
# The server's public IPv4 address, announced to clients for the audio (ip -4 addr show ens3).
PUBLIC_IP=
# The secret shared by Plume Lite and LiveKit: generate it once, on the server, with
#   openssl rand -hex 32
LIVEKIT_SECRET=
