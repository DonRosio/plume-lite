# Plume Lite, imported by /etc/caddy/Caddyfile (`import /etc/caddy/plume-lite.caddy`). Its
# containers (compose.yaml) only listen on the server itself: the app on port 3200, the
# voice server's signalling on 7880. WebSockets (/gateway, /rtc) go through as is.
plume.donrgames.fr {
	header {
		# Clients will only use HTTPS for this site, for a year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	# Apart: removing a header makes Caddy defer the whole directive.
	header -Server

	encode zstd gzip

	# Voice: LiveKit's signalling (a WebSocket under /rtc). Its admin API stays private.
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}
